{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canada_funding_backing.schema.json",
  "title": "Canada institutional funding backing evidence",
  "type": "object",
  "required": [
    "evidence_id", "company_id", "track", "claim_type", "backing_type",
    "backer", "evidence_url", "evidence_date", "captured_at",
    "extraction_method", "confidence", "summary"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "track": {"const": "funding"},
    "claim_type": {"const": "institutional_backing"},
    "backing_type": {
      "enum": ["investor_portfolio", "funder_portfolio", "funded_or_developed_portfolio"]
    },
    "backer": {"type": "string", "minLength": 1},
    "evidence_url": {"type": "string", "format": "uri"},
    "evidence_date": {"type": ["string", "null"], "format": "date"},
    "captured_at": {"type": "string", "format": "date"},
    "extraction_method": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["high", "medium", "low"]},
    "summary": {"type": "string", "minLength": 1},
    "provenance_id": {"type": "string"}
  },
  "additionalProperties": true
}
