{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canada_enrichment_completeness.schema.json",
  "title": "Canada enrichment track completeness",
  "type": "object",
  "required": [
    "status",
    "attempted_at",
    "source_url",
    "raw_count",
    "accepted_count",
    "notes"
  ],
  "properties": {
    "status": {
      "enum": [
        "complete_matches",
        "complete_zero",
        "partial",
        "blocked",
        "failed",
        "no_source",
        "not_run",
        "manual_review"
      ]
    },
    "attempted_at": {"type": ["string", "null"], "format": "date"},
    "source_url": {"type": "string"},
    "raw_count": {"type": ["integer", "null"], "minimum": 0},
    "accepted_count": {"type": ["integer", "null"], "minimum": 0},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
